<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE — not the file that gets signed.

  scripts/mac-entitlements.mjs renders this to build/entitlements.mac.plist
  (gitignored) as electron-builder's beforePack hook, substituting the Team ID
  from $APPLE_TEAM_ID. When that variable is unset the whole
  keychain-access-groups block is dropped, so a cert-less local `npm run dist`
  still produces a runnable ad-hoc-signed app.

  __TEAM_ID__ is the placeholder. electron-builder does NOT expand Xcode's
  $(AppIdentifierPrefix), so the prefix has to be literal in the signed plist.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: the three Electron/V8 cannot start without. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Sensitive resources Raha brokers for pages (R-103 asks first). -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>

  <!-- "Import open tabs" shells out to osascript (JXA) to read the other
       browser's windows — that is Apple Events. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
__KEYCHAIN_ACCESS_GROUPS__
</dict>
</plist>
